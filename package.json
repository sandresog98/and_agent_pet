{
  "name": "dsh-session-notifier",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "Single-repo, platform-adaptive native overlay for DeepSeek Harness with a Gengar-ready pet, activity bubble, and two soft alert chimes.",
  "license": "MIT",
  "author": "Andres Olaya",
  "repository": {
    "type": "git",
    "url": "https://github.com/sandresog98/and_agent_pet.git"
  },
  "homepage": "https://github.com/sandresog98/and_agent_pet#readme",
  "bugs": {
    "url": "https://github.com/sandresog98/and_agent_pet/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "windows",
    "overlay",
    "gengar",
    "notifications"
  ],
  "scripts": {
    "extract-frames": "python tools/extract_gengar_frames.py"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "requirements.txt",
    "docs/*.md",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "overlay/platforms.json",
    "overlay/README.md",
    "overlay/windows/**",
    "overlay/macos/**",
    "overlay/linux/**",
    "overlay/frames/README.md",
    "overlay/frames/*/*.png",
    "tools/*.py"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
